{
  "name": "cfo-management-system",
  "private": true,
  "version": "0.1.0",
  "description": "公開發行公司財務長（CFO）管理系統：職能地圖、法遵行事曆、定期任務、檢核引擎",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docs": "UPDATE_DOCS=1 vitest run src/domain/docs.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^4.0.18"
  }
}
