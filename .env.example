# 複製為 .env 後修改。請勿將填好的 .env 提交進版控。

# ── 初次啟動時建立的管理者帳號（建立後可移除） ──
CFO_ADMIN_USER=cfo
CFO_ADMIN_PASSWORD=請改成至少12碼的強密碼
CFO_ADMIN_NAME=財務長

# ── 部署環境 ──
# 由 Nginx / Traefik 等反向代理終結 TLS 時設為 1
CFO_TRUST_PROXY=1
# 連線階段有效時數
CFO_SESSION_TTL_HOURS=12
# 0 = 空白工作區（正式導入）；1 = 內建示範資料（教育訓練）
CFO_SEED_DEMO=0

# ── 進階（通常不需修改） ──
# CFO_PORT=8080
# CFO_HOST=0.0.0.0
# CFO_DATA_DIR=/data
# CFO_STATIC_DIR=/app/dist
# CFO_LOGIN_MAX_ATTEMPTS=8
# CFO_LOGIN_WINDOW_MINUTES=15
