{
  "name": "pdf-editor-windows",
  "version": "1.0.0",
  "description": "PDF 編輯器（Windows 版）",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare-assets": "node scripts/copy-ocr-assets.mjs && node scripts/make-icon.mjs",
    "build": "npm run prepare-assets && tsc -p . && vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "e2e": "node e2e/app.e2e.mjs",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "author": "PDF 編輯器",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/chi_tra": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/jpn": "^1.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "mupdf": "^1.28.1",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module",
  "build": {
    "appId": "com.example.pdfeditor",
    "productName": "PDF 編輯器",
    "executableName": "PDFEditor",
    "copyright": "PDF 編輯器",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF 文件",
        "description": "PDF 文件",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF 編輯器",
      "artifactName": "PDFEditor-Setup-${version}-${arch}.${ext}",
      "installerLanguages": [
        "zh_TW",
        "en_US"
      ],
      "language": "1028",
      "unicode": true
    },
    "portable": {
      "artifactName": "PDFEditor-Portable-${version}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dong0209/CFO.git",
    "directory": "PDFEditorWindows"
  }
}
